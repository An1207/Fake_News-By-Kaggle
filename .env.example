# Reference only. scripts/init_web_env.py generates real passwords in .env.
# FastAPI and Docker Compose read .env; news_ai CLI uses process environment.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=sai_news
MYSQL_USER=sai_app
MYSQL_PASSWORD=replace_with_generated_password
MYSQL_ROOT_PASSWORD=replace_with_generated_root_password
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AI_ENABLED=false
# Optional primary-result override; both models still run for web classification.
# Omitted selects the validation-recommended primary result.
# CLASSIFIER_PATH=artifacts/classifier.joblib
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:2.4b
OLLAMA_TIMEOUT=180
